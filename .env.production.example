ENVIRONMENT=production
POSTGRES_USER=leveling
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=leveling_system
DATABASE_URL=postgresql+asyncpg://leveling:replace-with-a-random-database-password@db:5432/leveling_system
FRONTEND_URL=https://leveling.example.com
CORS_ORIGINS=https://leveling.example.com
ALLOWED_HOSTS=leveling.example.com
COOKIE_SECURE=true
GOOGLE_REDIRECT_URI=https://leveling.example.com/api/auth/callback
MOBILE_REDIRECT_URIS=
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOW_GUEST_LOGIN=false
ALLOWED_EMAILS=
