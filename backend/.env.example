DATABASE_URL=postgresql+asyncpg://leveling:leveling123@localhost:5433/leveling_system
ENVIRONMENT=development

# Google OAuth - Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# JWT - Generate a secure random string
JWT_SECRET=your-super-secret-jwt-key-change-this

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
DATABASE_ECHO=false

# Personal-use access controls
# Leave ALLOWED_EMAILS empty for local development, set it in production.
ALLOWED_EMAILS=
ALLOW_GUEST_LOGIN=true
MOBILE_REDIRECT_URIS=
